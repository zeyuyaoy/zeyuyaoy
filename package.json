{
  "name": "zeyuyaoy",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun run test:portfolio && bun run test:research",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "check:routes": "bun scripts/check-routes.mjs",
    "spotify:authorize": "node scripts/spotify-authorize.mjs",
    "test:portfolio": "bun test ./tests",
    "test:research": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "redis": "6.2.1",
    "js-yaml": "5.4.2",
    "lucide-react": "1.48.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "jsdom": "30.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.61.1"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "baseline-browser-mapping": "2.11.22",
    "browserslist": "4.28.9"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  }
}
